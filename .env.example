############################################################
# Supabase / Stack Configuration — LOCAL ONLY
# Copy this file to .env. The defaults are set for DEV MODE and work as-is.
#
# This file covers BOTH local modes. See the URLs section below to switch.
# The VPS uses .env_prd instead, applied by apply-secrets.sh.
############################################################

# ===========================================
# PostgreSQL Database
# ===========================================
POSTGRES_PASSWORD=your-super-secret-password

# ===========================================
# JWT Configuration
# IMPORTANT: Change this in production!
# Must be at least 32 characters
# ===========================================
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
JWT_EXP=3600

# ===========================================
# API Keys (Pre-generated for local dev)
# NOTE: ANON_KEY / SERVICE_ROLE_KEY are JWTs signed with JWT_SECRET.
# If you change JWT_SECRET, you MUST regenerate these keys:
# https://supabase.com/docs/guides/self-hosting#api-keys
# Anon key - for public/anonymous access
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Service role key - for admin/backend access (KEEP SECRET!)
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# ===========================================
# URLs — must match the URL in your browser's address bar
# ===========================================
# GoTrue puts SITE_URL into confirmation/recovery email links and post-auth
# redirects, so a mismatch sends users to a dead origin. Set for:
#
#   Option A — DEV (active):    http://localhost:8080
#   Option B — PROD, run local: http://feast.localhost:8080
#
# To switch, move the `#` on both pairs below. Keep them identical to each
# other AND to frontend/.env's VITE_SUPABASE_URL / VITE_API_GATEWAY_URL.
#
# Both are the Caddy gateway on :8080 — NOT supabase-kong's :8100 and NOT
# Vite's :5173. Those ports bypass the gateway and break auth redirects.

# External URL for the Supabase API (Kong Gateway)
API_EXTERNAL_URL=http://localhost:8080
# API_EXTERNAL_URL=http://feast.localhost:8080         # Option B

# Frontend URL (for redirects after auth)
SITE_URL=http://localhost:8080
# SITE_URL=http://feast.localhost:8080                 # Option B

# Additional redirect URLs (comma-separated)
ADDITIONAL_REDIRECT_URLS=

# ===========================================
# Auth Settings
# ===========================================
# Set to true to disable new user signups
DISABLE_SIGNUP=false

# Email signup settings
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true

# Phone signup settings
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=true

# Anonymous users
ENABLE_ANONYMOUS_USERS=false

# ===========================================
# SMTP Configuration (Optional - for email verification)
# Leave empty to use auto-confirm for local dev
# ===========================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=admin@localhost

# ===========================================
# PostgREST Settings
# ===========================================
PGRST_DB_SCHEMAS=public,storage,graphql_public

# ===========================================
# Logging (Optional)
# ===========================================
LOGFLARE_API_KEY=

# ===========================================
# Kong Gateway Database
# ===========================================
# Interpolation-only (kong-database / kong-migration / kong do not load an
# env_file), so it must live HERE, not in backend/.env.
KONG_PG_PASSWORD=password

# ===========================================
# CORS
# ===========================================
# Needed here for ${} interpolation by kong-setup. Also present in backend/.env,
# where the 17 Flask services read it via env_file — keep both in sync.
# ALLOWED_ORIGIN  (singular) -> read by Caddy    (backend/.env)
# ALLOWED_ORIGINS (plural)   -> read by kong-setup (this file)
#
# `*` matches every local origin, so this needs no Option A/B toggle.
# The VPS pins it to the real domain in .env for prd.
ALLOWED_ORIGINS=*
