############################################################
# FeastFinder Backend Environment Configuration
# Copy this file to .env and customize as needed
############################################################

# ===========================================
# Supabase Configuration (Local)
# ===========================================
# For LOCAL Supabase (self-hosted via Docker)
# Backend services use the SERVICE_ROLE key — bypasses RLS, full read/write.
# The frontend's anon key would be denied by RLS for authenticated-user data.
SUPABASE_URL=http://supabase-kong:8000
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# ===========================================
# Supabase Configuration (Cloud) - ALTERNATIVE
# ===========================================
# For CLOUD Supabase (hosted at supabase.co)
# Uncomment and replace with your cloud credentials
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_KEY=your-anon-key-here

# ===========================================
# Stripe Configuration (Payment Processing)
# ===========================================
# Get keys from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# ===========================================
# Resend Email Configuration (Notifications)
# ===========================================
RESEND_API_KEY=re_your_resend_api_key_here
SENDER_EMAIL=onboarding@resend.dev
DEFAULT_RECIPIENT_EMAIL=delivered@resend.dev

