############################################################
# FeastFinder Backend Environment Configuration
# Copy this file to .env and customize as needed
############################################################

# ===========================================
# Supabase Configuration
# ===========================================
# Container-internal address — identical in dev, prod-run-locally, and on the
# VPS. It never leaves the Docker network, so it needs no Option A/B toggle.
#
# Backend services use the SERVICE_ROLE key — bypasses RLS, full read/write.
# The frontend's anon key would be denied by RLS for authenticated-user data.
SUPABASE_URL=http://supabase-kong:8000
SUPABASE_KEY=your_service_role_key_here

# ===========================================
# Stripe Configuration (Payment Processing)
# ===========================================
# Get keys from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# ===========================================
# Resend Email Configuration (Notifications)
# ===========================================
RESEND_API_KEY=re_your_resend_api_key_here
SENDER_EMAIL=onboarding@resend.dev
DEFAULT_RECIPIENT_EMAIL=delivered@resend.dev

# ===========================================
# Kong Gateway Database Configuration
# ===========================================
# KONG username is kong
# MOVED to the project-root .env — kong-database/kong-migration/kong consume it
# via ${} interpolation, which cannot read env_file. Setting it here has no effect.
# KONG_PG_PASSWORD=password

# ===========================================
# CORS Security Configuration
# ===========================================
# Managed globally by Caddy Gateway edge.
# Local Dev Default: *
# Production Deployment: Change ALLOWED_ORIGIN to your domain (e.g., https://feast.weishenlo.com)
ALLOWED_ORIGIN=*
ALLOWED_ORIGINS=*

