############################################################
# Supabase Local Development Configuration
# Copy this file to .env and customize as needed
############################################################

# ===========================================
# PostgreSQL Database
# ===========================================
POSTGRES_PASSWORD=your-super-secret-password

# ===========================================
# JWT Configuration
# IMPORTANT: Change this in production!
# Must be at least 32 characters
# ===========================================
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
JWT_EXP=3600

# ===========================================
# API Keys (Pre-generated for local dev)
# These are generated using the JWT_SECRET above
# Generate new ones at: https://supabase.com/docs/guides/self-hosting#api-keys
# ===========================================
# Anon key - for public/anonymous access
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Service role key - for admin/backend access (KEEP SECRET!)
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# ===========================================
# URLs
# ===========================================
# External URL for the Supabase API (Kong Gateway)
API_EXTERNAL_URL=http://localhost:8100

# Frontend URL (for redirects after auth)
SITE_URL=http://localhost:5173

# Additional redirect URLs (comma-separated)
ADDITIONAL_REDIRECT_URLS=

# ===========================================
# Auth Settings
# ===========================================
# Set to true to disable new user signups
DISABLE_SIGNUP=false

# Email signup settings
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true

# Phone signup settings
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=true

# Anonymous users
ENABLE_ANONYMOUS_USERS=false

# ===========================================
# SMTP Configuration (Optional - for email verification)
# Leave empty to use auto-confirm for local dev
# ===========================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=admin@localhost

# ===========================================
# PostgREST Settings
# ===========================================
PGRST_DB_SCHEMAS=public,storage,graphql_public

# ===========================================
# Logging (Optional)
# ===========================================
LOGFLARE_API_KEY=
