# Caddyfile for Vue SPA Production Deployment
:80 {
    root * /usr/share/caddy
    encode gzip zstd

    # Security Headers
    header {
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # SPA Fallback: Serve index.html for any route not matching a physical file
    try_files {path} /index.html

    # Serve static files
    file_server
}
