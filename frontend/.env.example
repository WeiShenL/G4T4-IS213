############################################################
# FeastFinder Frontend Environment Configuration
# Copy this file to .env and customize as needed
############################################################

# ===========================================
# Origin — must match the URL in your browser's address bar, byte for byte
# ===========================================
# Vite bakes these into the bundle, so only ONE can be active at a time.
# The defaults below are set for DEV MODE and work as-is after a plain
# `docker compose up -d`. Nothing to change.
#
#   Option A — DEV (default):   http://localhost:8080
#   Option B — PROD, run local: http://feast.localhost:8080
#
# Switching to Option B: comment out the two localhost:8080 lines and uncomment
# the two feast.localhost:8080 lines. A mismatch between these and the URL you
# actually browse causes CORS origin errors, not 404s, so the symptom is
# misleading.
#
# The VPS does not use this file — see .env_prd for the real domain.

# ===========================================
# Supabase Configuration (Local)
# ===========================================
# For LOCAL Supabase (self-hosted via Docker)
VITE_SUPABASE_URL=http://localhost:8080
# VITE_SUPABASE_URL=http://feast.localhost:8080   # Option B — prod mode, run locally
VITE_SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# ===========================================
# API Gateway (Kong via Caddy Gateway)
# ===========================================
# URL for the Unified Gateway that routes to backend services via Kong.
# Keep this identical to VITE_SUPABASE_URL above — same Caddy, same origin.
VITE_API_GATEWAY_URL=http://localhost:8080
# VITE_API_GATEWAY_URL=http://feast.localhost:8080   # Option B — prod mode, run locally

# ===========================================
# Stripe Configuration (Payment Processing)
# ===========================================
# Get your publishable key from: https://dashboard.stripe.com/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# ===========================================
# Google Maps API
# ===========================================
# Get your API key from: https://console.cloud.google.com/google/maps-apis
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
