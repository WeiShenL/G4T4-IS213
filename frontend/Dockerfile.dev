# Development Dockerfile with Vite Hot Module Reloading (HMR)
FROM node:20-alpine
WORKDIR /app

# Copy manifests and install dependencies
COPY package*.json ./
RUN npm install

# Copy application source
COPY . .

EXPOSE 80

# Run Vite dev server bound to all interfaces on port 80 for container access
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "80"]
